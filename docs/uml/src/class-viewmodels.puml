@startuml
set separator none
left to right direction
skinparam monochrome false
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 45
skinparam ArrowColor #000000
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam classFontColor #000000
skinparam classFontStyle bold
skinparam classAttributeFontStyle normal
skinparam stereotypeCBackgroundColor #FFFFFF
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
skinparam noteBackgroundColor #FFFFFF
skinparam noteBorderColor #000000
skinparam linetype ortho
skinparam roundCorner 0
hide empty members
hide circle

title Диаграмма классов: слой представления (MVVM)



  class "**App**" as App {
    -m_services : IServiceProvider
    +OnStartup() : void
    +OnExit() : void
  }

  class "**ShellWindow**" as ShellWindow {
    +ViewModel : MainViewModel
  }

  abstract class "**ViewModelBase**" as ViewModelBase {
    #SetProperty~T~(field : T, value : T) : bool
  }

  class "**MainViewModel**" as MainViewModel {
    +Hosts : ObservableCollection~HostCardViewModel~
    +IsMonitoring : bool
    +CheckCommand : IAsyncRelayCommand
    +ToggleMonitoringCommand : IRelayCommand
    +AddHostCommand : IAsyncRelayCommand
    +RemoveHostCommand : IAsyncRelayCommand
    +OpenDetailsCommand : IRelayCommand
  }

  class "**HostCardViewModel**" as HostCardViewModel {
    +Host : Host
    +Status : HostStatus
    +Latency : TimeSpan
    +PacketLoss : double
    +ResolvedAddress : IPAddress
    +Apply(snapshot : HostSnapshot) : void
  }

  class "**HostDetailsViewModel**" as HostDetailsViewModel {
    +Host : Host
    +History : IReadOnlyList~HistoryPoint~
    +LoadHistory() : void
  }

  class "**PortsViewModel**" as PortsViewModel {
    +Host : Host
    +PortSet : PortSet
    +Results : ObservableCollection~PortResult~
    +Progress : int
    +ScanCommand : IAsyncRelayCommand
    +CancelCommand : IRelayCommand
  }

  class "**LanDiscoveryViewModel**" as LanDiscoveryViewModel {
    +Hosts : ObservableCollection~LanHostInfo~
    +IsScanning : bool
    +ScanCommand : IAsyncRelayCommand
    +AddToMonitoringCommand : IAsyncRelayCommand
  }

  class "**SettingsViewModel**" as SettingsViewModel {
    +Settings : AppSettings
    +SaveCommand : IAsyncRelayCommand
    +ApplyTheme(theme : ThemeMode) : void
  }



package "Контракты LiquidPing.Core" {
  interface IMonitoringService
  interface IPortScanner
  interface ILanDiscovery
  interface IHostRepository
  interface ISettingsStore
  interface IHistoryStore
}

App ..> ShellWindow

ShellWindow --> MainViewModel

MainViewModel --|> ViewModelBase
HostCardViewModel --|> ViewModelBase
HostDetailsViewModel --|> ViewModelBase
PortsViewModel --|> ViewModelBase
LanDiscoveryViewModel --|> ViewModelBase
SettingsViewModel --|> ViewModelBase

MainViewModel --> IMonitoringService
MainViewModel --> IHostRepository
MainViewModel *--> "1..*" HostCardViewModel
HostDetailsViewModel --> IHistoryStore
PortsViewModel --> IPortScanner
LanDiscoveryViewModel --> ILanDiscovery
LanDiscoveryViewModel --> IHostRepository
SettingsViewModel --> ISettingsStore

HostCardViewModel ..> HostSnapshot
PortsViewModel ..> PortResult
LanDiscoveryViewModel ..> LanHostInfo
@enduml
