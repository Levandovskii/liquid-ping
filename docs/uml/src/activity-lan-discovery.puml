@startuml
skinparam shadowing false
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #334E96
title Обнаружение хостов в локальной сети и добавление в мониторинг (UC-06, UC-07)

start
:Пользователь нажал «Сканировать сеть»<
:Определить IPv4-подсети активных адаптеров;
if (Подсети найдены?) then (нет)
    :Показать сообщение «Нет активной сети»;
    stop
endif
repeat :Взять очередную подсеть;
    if (Префикс короче /22?) then (да)
        :Показать сообщение «Подсеть слишком велика»;
    else (нет)
        :Сформировать адреса подсети;
        :Проверить адреса по ICMP\n(параллельно, до 64);
        note right
            Прогресс виден постоянно,
            «Отмена» доступна в любой момент
        end note
        :Прочитать ARP-таблицу подсети;
        if (Есть запись ARP без ответа на ICMP?) then (да)
            :Добавить «тихий» хост\n(задержка не определена);
        endif
        :Определить производителя по MAC (OUI);
        :Определить имя хоста (reverse DNS);
    endif
repeat while (Есть ещё подсети?) is (да) not (нет)
:Показать список найденных хостов;
if (Пользователь нажал «В мониторинг»?) then (да)
    if (Хост уже в списке?) then (да)
        :Показать сообщение «Уже в списке»;
    else (нет)
        :Добавить хост в репозиторий;
        :Показать хост на главном экране\nсо статусом Pending;
    endif
endif
stop
@enduml
