@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #334E96
}
skinparam actor {
    BorderColor #334E96
}
title LiquidPing: диаграмма вариантов использования

actor "Пользователь" as User
actor "Таймер" as Timer
actor "Сетевой стек\nWindows" as Net
actor "Центр уведомлений\nWindows" as Toast

rectangle "LiquidPing" {
    usecase "UC-01\nУправлять списком узлов" as UC01
    usecase "UC-02\nЗапустить и остановить\nмониторинг" as UC02
    usecase "UC-03\nВыполнить цикл проверок" as UC03
    usecase "UC-04\nПросмотреть детали узла\nи историю" as UC04
    usecase "UC-05\nСканировать порты узла" as UC05
    usecase "UC-06\nОбнаружить хосты\nв локальной сети" as UC06
    usecase "UC-07\nДобавить найденный хост\nв мониторинг" as UC07
    usecase "UC-08\nНастроить приложение" as UC08
    usecase "UC-09\nЭкспортировать результаты" as UC09
    usecase "UC-10\nПоказать уведомление\nо смене статуса" as UC10
    usecase "UC-11\nСвернуть в системный трей" as UC11
    usecase "UC-12\nПроверить введённые данные" as UC12
}

User --> UC01
User --> UC02
User --> UC03
User --> UC04
User --> UC05
User --> UC06
User --> UC07
User --> UC08
User --> UC09
User --> UC11
Timer --> UC03

UC03 --> Net
UC05 --> Net
UC06 --> Net
UC10 --> Toast

UC01 .> UC12 : <<include>>
UC05 .> UC12 : <<include>>
UC08 .> UC12 : <<include>>
UC07 .> UC06 : <<extend>>
UC10 .> UC03 : <<extend>>
@enduml
