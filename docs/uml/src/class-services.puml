@startuml
set separator none
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 45
skinparam ArrowColor #000000
hide empty members
hide circle

title Диаграмма классов: сервисы приложения

package "LiquidPing.App.Services" {
  class MonitoringCoordinator {
    -m_monitoring : IMonitoringService
    -m_channel : Channel~HostSnapshot~
    +Started : event EventHandler
    +BatchReady : event EventHandler~BatchEventArgs~
    +Start(interval : TimeSpan) : void
    +Stop() : void
  }

  class NavigationService {
    +ShowDetails(host : Host) : void
    +ShowPorts(host : Host) : void
    +ShowSettings() : void
    +ShowLanDiscovery() : void
  }

  class NotificationService {
    +IsEnabled : bool
    +Notify(args : HostUpdatedEventArgs) : void
  }

  class ThemeService {
    +Current : ThemeMode
    +Apply(theme : ThemeMode) : void
  }

  class LocalizationService {
    +Language : string
    +Apply(language : string) : void
    +Get(key : string) : string
  }

  class TrayService {
    +IsEnabled : bool
    +Show() : void
    +Hide() : void
  }

  interface IDialogService {
    +ConfirmAsync(message : string) : Task~bool~
    +ShowError(message : string) : Task
  }

  class DialogService {
    +ConfirmAsync(message : string) : Task~bool~
    +ShowError(message : string) : Task
  }
}

class MainViewModel {
  +Hosts : ObservableCollection~HostCardViewModel~
  +IsMonitoring : bool
}

class SettingsViewModel {
  +Settings : AppSettings
}

interface IMonitoringService {
  +HostUpdated : event EventHandler~HostUpdatedEventArgs~
}

class HostUpdatedEventArgs {
  +Snapshot : HostSnapshot
}

MonitoringCoordinator --> IMonitoringService
MonitoringCoordinator --> NotificationService : пересылает\nсмену статуса
NotificationService ..> HostUpdatedEventArgs
NavigationService ..> MainViewModel : открывает экраны
MainViewModel ..> MonitoringCoordinator
SettingsViewModel ..> ThemeService
SettingsViewModel ..> LocalizationService
DialogService ..|> IDialogService
TrayService ..> MainViewModel : восстанавливает окно

note bottom of MonitoringCoordinator
  PeriodicTimer работает внутри
  IMonitoringService, результаты
  передаются пакетом каждые 150 мс
  (ADR-0004)
end note
@enduml
